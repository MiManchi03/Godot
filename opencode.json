{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-3-5-haiku-20241022",
  "default_agent": "godot-engineer",
  "logLevel": "INFO",
  "instructions": [
    "AGENTS.md",
    "HARNESS_PLAN.md"
  ],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "agent": {
    "godot-engineer": {
      "description": "Godot 4.x 游戏开发工程师，具备完整 Harness 技能访问权限",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "skill": {
          "godot-*": "allow"
        }
      }
    }
  },
  "permission": {
    "skill": {
      "godot-*": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git push --force*": "ask",
      "git reset *": "allow",
      "git reset --hard*": "ask",
      "git reset --mixed *": "allow",
      "git clean *": "ask",
      "git rebase *": "ask",
      "git checkout *": "allow",
      "git checkout -f*": "ask",
      "git checkout -- *": "ask",
      "git checkout .": "ask",
      "git restore *": "ask",
      "git merge *": "ask",
      "git config *": "ask",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "python *": "allow",
      "dotnet *": "allow",
      "timeout *": "allow",
      "godot *": "allow",
      "*Godot*": "allow",
      "head *": "allow"
    },
    "external_directory": {
      "D:\\Godot\\**": "allow",
      "D:\\Skills\\**": "allow"
    }
  },
  "experimental": {
    "compaction": {
      "auto": true,
      "tail_turns": 15
    }
  }
}
